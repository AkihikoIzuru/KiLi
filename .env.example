# 9Router Configuration (server-side only, never expose via NEXT_PUBLIC_)
NINE_ROUTER_BASE_URL=https://rf3wulm.abc-tunnel.us/v1
NINE_ROUTER_API_KEY=your-secret-key-here

# Optional: Default model if not specified by user
DEFAULT_MODEL=

# Database (Vercel Postgres)
# Get these from Vercel Dashboard -> Storage -> Postgres
POSTGRES_URL="postgres://..."
POSTGRES_PRISMA_URL="postgres://..."
POSTGRES_URL_NON_POOLING="postgres://..."

# NextAuth.js
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-nextauth-secret-here"
NEXTAUTH_URL="http://localhost:3000"
